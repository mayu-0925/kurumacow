RewriteEngine On

# HTTP → HTTPS リダイレクト
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# HTTP リソースを自動的に HTTPS にアップグレード
Header always set Content-Security-Policy "upgrade-insecure-requests"

# ──────────────────────────────────────────────
# 旧WordPress URL → 301リダイレクト
# ──────────────────────────────────────────────

# カテゴリ個別リダイレクト
Redirect 301 /category/insurance/ https://kurumacow.com/blog/
Redirect 301 /category/trivia/ https://kurumacow.com/blog/
Redirect 301 /category/trivia/雑学/ https://kurumacow.com/blog/
Redirect 301 /category/trivia/change/ https://kurumacow.com/blog/
Redirect 301 /category/trivia/loan/ https://kurumacow.com/blog/
Redirect 301 /category/trivia/rule/ https://kurumacow.com/blog/
Redirect 301 /category/kaitori/ https://kurumacow.com/blog/
Redirect 301 /category/kaitori/review/ https://kurumacow.com/blog/
Redirect 301 /category/kaitori/base/ https://kurumacow.com/blog/
Redirect 301 /category/kaitori/trouble/ https://kurumacow.com/blog/
Redirect 301 /category/new/ https://kurumacow.com/blog/
Redirect 301 /category/new/newcarinfo/ https://kurumacow.com/blog/

# 旧記事URL パターンリダイレクト（正規表現）
# /trivia/[数字]/ → /blog/
RewriteRule ^trivia/[0-9]+/?$ https://kurumacow.com/blog/ [R=301,L]

# /kaitori/[数字]/ → /blog/
RewriteRule ^kaitori/[0-9]+/?$ https://kurumacow.com/blog/ [R=301,L]

# /new/newcar/[数字]/ → /blog/
RewriteRule ^new/newcar/[0-9]+/?$ https://kurumacow.com/blog/ [R=301,L]

# /new/[数字]/ → /blog/
RewriteRule ^new/[0-9]+/?$ https://kurumacow.com/blog/ [R=301,L]
