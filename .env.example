# Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# WordPress REST API
WP_URL=https://kurumacow.com
WP_USERNAME=your_wp_username
# WordPressの「ユーザー > プロフィール > アプリケーションパスワード」で生成
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# 投稿設定（オプション）
WP_DEFAULT_CATEGORY_ID=1   # カテゴリIDを指定（未指定なら「未分類」）
WP_STATUS=draft             # draft（下書き）または publish（即公開）
